#!/bin/bash
# The fuzz image's driver: runs fileio-catalog's fuzz rounds and calibrations on commits of a git
# bundle, against a chosen build of the Iceberg fork, offline.
#
#   ce-fuzz round <fork> <commit> <name>        a phase-exit round: the ten jobs below
#   ce-fuzz calib <fork> <commit> <name> <set>  a calibration: each mutant of mutants/<set>.sh,
#                                               put back in its own worktree, against the oracles
#   ce-fuzz test <fork> <commit> <name> <tests> one job: mvn test -Dtest=<tests>, tries as written
#   ce-fuzz shrink <fork> <commit> <name> <run>/<job>
#                                               shrinks each property that failed in a round's job
#                                               (or a test job), one at a time: reruns it alone,
#                                               with the job's tries and the seed it failed with,
#                                               in a JVM of SHRINK_HEAP
#   ce-fuzz status [name]                       each job of each run (or one): running or its exit,
#                                               and its result lines
#
# <fork> names a build of the fork's jars (/opt/m2/forks/<fork>; `ls` it). <commit> is anything
# git can resolve in /in/fileio.bundle. Logs go to /out/<name>/<job>.log, summaries to
# /out/<name>/summary.txt. Env: JOBS, how many jobs run at once (default: all of them; a
# shrink's, 1); HEAP, each test JVM's heap (default 4g); SHRINKING, jqwik's shrinking in rounds,
# calibrations and test jobs (default OFF: a failure reports its sample and seed at once, and
# shrink shrinks it); SHRINK_HEAP (default 16g) and SHRINK_SECONDS (default 1800), a shrink's heap
# and how long jqwik shrinks; JOB_TIMEOUT, a limit on each job's time (as timeout(1) takes it;
# default none, a shrink's twice SHRINK_SECONDS and an hour); SMOKE=1 sets every property's
# tries to 3 (to check the image, not the code).
#
# A round's jobs (tries per @Property, in the order the class declares them):
#   faultA1-2  TestCatalogFaultProperties.catalogMatchesModel, 30,000
#   faultB1-2  TestCatalogFaultProperties.faultyStorageNeverMisreportsACommit, 30,000
#   race       TestCatalogRaceProperties, 200,000
#   mw         spec.TestMultiWriterProperties, 300,000 each
#   proto      TestMemoryCommitProtocol and TestAtomicFileCommitProtocol, 300,000 each
#   rebase     TestRebaseProperties, 3,000 each (REBASE_TRIES: each in turn)
#   contract   the ConflictEncodingContract subclasses, 2,000 each
set -uo pipefail

BUNDLE=/in/fileio.bundle
SRC=/work/src
T=iceberg-fileio-catalog/src/test/java/org/apache/iceberg/io
HEAP=${HEAP:-4g}
SHRINKING=${SHRINKING:-OFF}

die() { echo "ce-fuzz: $*" >&2; exit 2; }

clone() {
  [ -f $BUNDLE ] || die "no bundle at $BUNDLE (mount one: -v <file>:$BUNDLE:ro)"
  # bare, so the bundle's branches are branches here, not origin/<branch>
  [ -d $SRC ] || git clone -q --bare $BUNDLE $SRC || die "cannot clone $BUNDLE"
}

# fork name: the Maven repository of its jars, chained to the shared base
repo() {
  [ -d /opt/m2/forks/$1 ] || die "no fork build '$1' (have: $(ls /opt/m2/forks | tr '\n' ' '))"
  echo "-Dmaven.repo.local=/opt/m2/forks/$1 -Dmaven.repo.local.tail=/opt/m2/base"
  echo "-Dmaven.repo.local.tail.ignoreAvailability=true"
}

# worktree <dir> <commit>
worktree() {
  git -C $SRC worktree add -q --detach "$1" "$2" || die "cannot check out $2"
}

# tries <file> <tries...>: sets each @Property's tries, in order (one value: all of them)
tries() {
  [ "${SMOKE:-0}" = 1 ] && set -- "$1" 3
  python3 - "$@" <<'PY'
import sys, re
f = sys.argv[1]; tries = sys.argv[2:]
s = open(f).read(); n = [0]
def sub(m):
    t = tries[min(n[0], len(tries) - 1)]; n[0] += 1; return '@Property(tries = %s)' % t
s = re.sub(r'@Property\(tries = \d+\)', sub, s); open(f, 'w').write(s)
PY
}

# mutate <file> <old> <new>: replaces the one occurrence of <old>
mutate() {
  python3 - "$@" <<'PY'
import sys
f, old, new = sys.argv[1:4]
s = open(f).read()
if s.count(old) != 1:
    sys.exit('%s: %d occurrences of the anchor, not 1:\n%s' % (f, s.count(old), old))
open(f, 'w').write(s.replace(old, new))
PY
}

# job <dir> <log> <tests>: one offline test run in <dir>, waiting for a free slot of JOBS. Its
# test JVM has HEAP, and jqwik's shrinking is SHRINKING (for SHRINK_SECONDS when bounded).
job() {
  while [ "$(jobs -rp | wc -l)" -ge "${JOBS:-64}" ]; do wait -n; done
  (
    cd "$1" || exit 2
    start=$(date +%s)
    echo "start $(date -Is) $(git rev-parse --short HEAD) fork=$FORK heap=$HEAP" \
      "shrinking=$SHRINKING timeout=${JOB_TIMEOUT:-none}" > "$2"
    # shellcheck disable=SC2046
    MAVEN_OPTS=-Xmx512m ${JOB_TIMEOUT:+timeout -k 120 $JOB_TIMEOUT} mvn -o -B $(repo $FORK) test \
      "-DargLine=-Xmx$HEAP -Djqwik.shrinking.default=$SHRINKING
        -Djqwik.shrinking.bounded.seconds=${SHRINK_SECONDS:-1800}" \
      -Dsurefire.failIfNoSpecifiedTests=false -Dtest="$3" >> "$2" 2>&1
    echo "exit=$? elapsed=$(( $(date +%s) - start ))s" >> "$2"
  ) &
}

# the failures and errors per test class of <log>, as "f+e Class ..."
classes() {
  grep -ahE "Tests run:.*in org" "$1" \
    | sed -E 's/.*Failures: ([0-9]+), Errors: ([0-9]+).* in org\.[a-z.]*\.([A-Za-z$]+)$/\1+\2 \3/' \
    | tr '\n' ' '
}

status() {
  for d in ${1:+/out/$1} ${1:-/out/*}; do
    [ -d "$d" ] || continue
    echo "### $(basename $d)"
    for f in "$d"/*.log; do
      [ -f "$f" ] || continue
      end=$(grep -ah '^exit=' "$f" | tail -1)
      echo "== $(basename $f .log): ${end:-running since $(head -1 $f | cut -d' ' -f2)}"
      grep -ahE 'Tests run:.*in org|tries = |FAIL|original-sample|Property \[' "$f" \
        | grep -v ' tries = 3 ' | head -8
    done
    [ -f "$d/summary.txt" ] && { echo "-- summary"; cat "$d/summary.txt"; }
  done
}

# A round's jobs
ROUND_JOBS="faultA1 faultB1 faultA2 faultB2 race mw proto rebase contract diff"

# tests_of <job>: the tests a round's job (or a test job) runs; a test job's are its own
tests_of() {
  case $1 in
    faultA*|faultB*) echo TestCatalogFaultProperties ;;
    race) echo TestCatalogRaceProperties ;;
    mw) echo TestMultiWriterProperties ;;
    proto) echo TestMemoryCommitProtocol,TestAtomicFileCommitProtocol ;;
    rebase) echo TestRebaseProperties ;;
    contract) echo 'Test*Encoding' ;;
    diff) echo TestInlineDifferentialProperties,TestInlineDeltaProperties ;;
    test) ;;
    *) die "no job $1 in a round" ;;
  esac
}

# setup <job> <dir>: sets the tries of the job's properties in the worktree <dir>
setup() {
  case $1 in
    faultA*) tries $2/$T/TestCatalogFaultProperties.java 30000 1 ;;
    faultB*) tries $2/$T/TestCatalogFaultProperties.java 1 30000 ;;
    race) tries $2/$T/TestCatalogRaceProperties.java 200000 ;;
    mw) tries $2/$T/spec/TestMultiWriterProperties.java 300000 ;;
    proto)
      tries $2/intentlog-memory/src/test/java/org/intentlog/memory/TestMemoryCommitProtocol.java 300000
      tries $2/intentlog-fileio/src/test/java/org/intentlog/fileio/TestAtomicFileCommitProtocol.java 300000 ;;
    rebase) tries $2/$T/TestRebaseProperties.java ${REBASE_TRIES:-3000} ;;
    contract) tries $2/$T/ConflictEncodingContract.java 2000 ;;
    diff)
      tries $2/$T/TestInlineDifferentialProperties.java 3500
      tries $2/$T/TestInlineDeltaProperties.java 15000 ;;
    test) ;; # tries as written
  esac
}

round() {
  for j in $ROUND_JOBS; do
    worktree $W/$j $COMMIT && setup $j $W/$j
  done
  for j in $ROUND_JOBS; do
    job $W/$j $O/$j.log "$(tests_of $j)"
  done
  wait
  for f in $O/*.log; do
    echo "$(basename $f .log): $(grep -ah '^exit=' $f | tail -1) | $(classes $f)" >> $O/summary.txt
  done
}

# failed <log>: the properties that failed in a job's log, one "<class> <method> <seed>" each:
# surefire names each failure, and jqwik's report of the property gives the seed it ran with
failed() {
  python3 - "$1" <<'PY'
import re, sys
text = open(sys.argv[1], errors='replace').read()
seen = set()
for m in re.finditer(r'^\[ERROR\] (?:[a-z]\w*\.)*([A-Z][\w$]*)\.(\w+) -- Time elapsed.*<<< (?:FAILURE|ERROR)!',
                     text, re.M):
    cls, method = m.group(1), m.group(2)
    if (cls, method) in seen:
        continue
    seen.add((cls, method))
    seed = None
    header = r'^timestamp = [^,]*, ' + re.escape(cls) + ':' + re.escape(method) + r' = \s*$'
    for r in re.finditer(header, text, re.M):
        s = re.search(r'^seed = (-?\d+)', text[r.end():r.end() + 20000], re.M)
        seed = s.group(1) if s else seed
    if seed is None:
        print('%s.%s: no seed in its report' % (cls, method), file=sys.stderr)
        continue
    print(cls, method, seed)
PY
}

# pin <file> <method> <seed>: runs the property <method> of <file> with <seed>
pin() {
  python3 - "$@" <<'PY'
import re, sys
f, method, seed = sys.argv[1:4]
s = open(f).read()
m = re.search(r'@Property\(tries = (\d+)\)((?:\s+@[\w.]+(?:\([^)]*\))?)*\s+)void ' + re.escape(method) + r'\(', s)
if not m:
    sys.exit('%s: no @Property(tries = N) before void %s(' % (f, method))
pinned = '@Property(tries = %s, seed = "%s")' % (m.group(1), seed)
s = s[:m.start()] + pinned + s[m.start() + len('@Property(tries = %s)' % m.group(1)):]
open(f, 'w').write(s)
PY
}

# shrink <run>/<job>: each property that failed in the job, in a worktree set up as the job's
# was, pinned to its seed, run alone (JOBS at a time, default 1), shrinking for SHRINK_SECONDS in
# a JVM of SHRINK_HEAP
shrink() {
  local log=/out/$1.log job=${1#*/}
  [ -f $log ] || die "no job log $log"
  tests_of $job > /dev/null
  HEAP=${SHRINK_HEAP:-16g}; SHRINKING=BOUNDED; JOBS=${JOBS:-1}
  JOB_TIMEOUT=${JOB_TIMEOUT:-$(( 2 * ${SHRINK_SECONDS:-1800} + 3600 ))}
  failed $log > $O/failed.txt 2>> $O/summary.txt
  [ -s $O/failed.txt ] || { echo "no failed property with a seed in $log" >> $O/summary.txt; return; }
  local cls method seed d file
  while read -r cls method seed; do
    d=$W/$method
    worktree $d $COMMIT && setup $job $d
    file=$(find $d -path '*/src/test/java/*' -name "$cls.java" | head -1)
    [ -n "$file" ] || { echo "$cls.$method: no $cls.java" >> $O/summary.txt; continue; }
    pin $file $method $seed 2>> $O/summary.txt || continue
    job $d $O/$cls.$method.log "$cls#$method"
  done < $O/failed.txt
  wait
  while read -r cls method seed; do
    [ -f $O/$cls.$method.log ] || continue
    echo "$cls.$method seed=$seed: $(grep -ah '^exit=' $O/$cls.$method.log | tail -1)" \
      "| shrunk: $(grep -aE '^Shrunk Sample' $O/$cls.$method.log | head -1)" >> $O/summary.txt
  done < $O/failed.txt
}

# A calibration set defines MUTANTS, ORACLES (one -Dtest), prepare <dir> (sets tries) and
# mutant <name> <main dir> <test dir> (puts the mutant back). "none" runs the oracles unmutated
# first: each must pass there, and fail on every mutant.
calib() {
  local set=/opt/ce-fuzz/mutants/$1.sh
  [ -f $set ] || die "no calibration set $1 (have: $(ls /opt/ce-fuzz/mutants | tr '\n' ' '))"
  # shellcheck source=/dev/null
  . $set
  for m in none $MUTANTS; do
    worktree $W/$m $COMMIT
    prepare $W/$m
    if [ $m != none ]; then
      (cd $W/$m && mutant $m iceberg-fileio-catalog/src/main/java/org/apache/iceberg/io \
          iceberg-fileio-catalog/src/test/java/org/apache/iceberg/io) \
        || { echo "$m: the mutant does not apply" >> $O/summary.txt; continue; }
    fi
    job $W/$m $O/$m.log "$ORACLES"
  done
  wait
  for m in none $MUTANTS; do
    [ -f $O/$m.log ] || continue
    c=$(classes $O/$m.log)
    if [ $m = none ]; then
      verdict=$(echo "$c" | grep -qE '(^| )[1-9][0-9]*\+|\+[1-9]' && echo "ORACLES FAIL UNMUTATED" || echo "clean")
    else
      verdict=$(echo "$c" | grep -qE '(^| )[1-9][0-9]*\+|\+[1-9]' && echo "caught" || echo "NOT CAUGHT")
    fi
    echo "$m: $verdict | $c" >> $O/summary.txt
  done
}

cmd=${1:-}; shift || true
case $cmd in
  round|calib|test|shrink)
    [ $# -ge 3 ] || die "usage: ce-fuzz $cmd <fork> <commit> <name> ..."
    FORK=$1; COMMIT=$2; NAME=$3; shift 3
    repo $FORK > /dev/null
    clone
    git -C $SRC rev-parse -q --verify "$COMMIT^{commit}" > /dev/null || die "no commit $COMMIT in the bundle"
    W=/work/$NAME; O=/out/$NAME
    [ -e $W ] && die "$W exists: names are one run each in a container"
    [ -n "$(ls -A $O 2>/dev/null)" ] && die "$O holds an earlier run: choose another name"
    mkdir -p $W $O
    echo "$cmd fork=$FORK commit=$(git -C $SRC rev-parse --short $COMMIT) jobs=${JOBS:-all} heap=$HEAP" \
      "shrinking=$SHRINKING smoke=${SMOKE:-0} cpus=$(nproc) mem=$(free -g | awk '/Mem:/ {print $2}')G" \
      "limit=$(cat /sys/fs/cgroup/memory.max 2>/dev/null || echo unknown) $(date -Is)" > $O/run.txt
    case $cmd in
      round) round ;;
      shrink) [ $# -ge 1 ] || die "usage: ce-fuzz shrink <fork> <commit> <name> <run>/<job>"; shrink $1 ;;
      calib) [ $# -ge 1 ] || die "usage: ce-fuzz calib <fork> <commit> <name> <set>"; calib $1 ;;
      test)
        [ $# -ge 1 ] || die "usage: ce-fuzz test <fork> <commit> <name> <tests>"
        worktree $W/test $COMMIT
        job $W/test $O/test.log "$1"; wait
        echo "test: $(grep -ah '^exit=' $O/test.log | tail -1) | $(classes $O/test.log)" >> $O/summary.txt ;;
    esac
    echo "done $(date -Is)" >> $O/run.txt
    cat $O/summary.txt ;;
  status) status "${1:-}" ;;
  *) sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
