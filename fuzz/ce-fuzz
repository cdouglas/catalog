#!/bin/bash
# The fuzz image's driver: runs fileio-catalog's fuzz rounds and calibrations on commits of a git
# bundle, against a chosen build of the Iceberg fork, offline.
#
#   ce-fuzz round <fork> <commit> <name>        a phase-exit round: the eleven jobs below
#   ce-fuzz calib <fork> <commit> <name> <set>  a calibration: each mutant of mutants/<set>.sh,
#                                               put back in its own worktree, against the oracles
#   ce-fuzz test <fork> <commit> <name> <tests> one job: mvn test -Dtest=<tests>, tries as written
#   ce-fuzz shrink <fork> <commit> <name> <run>/<job>
#                                               shrinks each property that failed in a round's job
#                                               (or a test job), one at a time: reruns it alone,
#                                               with the job's tries and the seed it failed with,
#                                               in a JVM of SHRINK_HEAP
#   ce-fuzz status [name]                       each job of each run (or one): running or its exit,
#                                               and its result lines
#
# <fork> names a build of the fork's jars (/opt/m2/forks/<fork>; `ls` it). <commit> is anything
# git can resolve in /in/fileio.bundle. A job's whole log goes to /out/<name>/<job>.log.gz (read
# it with zcat or zgrep -a, which also read one cut short), its start and exit lines to
# /out/<name>/<job>.log, and summaries to /out/<name>/summary.txt. Env: JOBS, how many jobs run
# at once (default: all of them; a shrink's, 1); HEAP, each test JVM's heap (default 4g); SHRINKING, jqwik's shrinking in rounds,
# calibrations and test jobs (default OFF: a failure reports its sample and seed at once, and
# shrink shrinks it); SHRINK_HEAP (default 16g) and SHRINK_SECONDS (default 1800), a shrink's heap
# and how long jqwik shrinks; JOB_TIMEOUT, a limit on each job's time (as timeout(1) takes it;
# default none, a shrink's twice SHRINK_SECONDS and an hour); SMOKE=1 sets every property's
# tries to 3 (to check the image, not the code); ROUND_JOBS, a round's jobs (default all eleven);
# SNAPSHOT_BLOCK and SNAPSHOT_WINDOW, the snapshot paging every catalog the tests make is created
# with (docs/SNAPSHOT_PAGING.md; LocalCatalogMode; unset, the catalog's default, which seals
# nothing in the fuzzers' short schedules, except in a round's faultA2 and faultB2, which page at
# 2 and 1; 0, none; window 8 with a block): 4 seals a table's blocks every few commits, and 2 with
# a window of 1 reaches re-inlining's import pages.
#
# A round's jobs (tries per @Property, in the order the class declares them):
#   faultA1-2  TestCatalogFaultProperties.catalogMatchesModel, 30,000 (A2 paging at 2 and 1)
#   faultB1-2  TestCatalogFaultProperties.faultyStorageNeverMisreportsACommit, 30,000 (B2 too)
#   race       TestCatalogRaceProperties: aRaceEndsAsASerialRun 200,000,
#              aTransactionRaceEndsAsASerialRun 10,000
#   mw         spec.TestMultiWriterProperties, 300,000 each
#   proto      TestMemoryCommitProtocol and TestAtomicFileCommitProtocol, 300,000 each
#   rebase     TestRebaseProperties, 3,000 each (REBASE_TRIES: each in turn)
#   contract   the ConflictEncodingContract subclasses, 2,000 each
set -uo pipefail

BUNDLE=/in/fileio.bundle
SRC=/work/src
T=iceberg-fileio-catalog/src/test/java/org/apache/iceberg/io
HEAP=${HEAP:-4g}
SHRINKING=${SHRINKING:-OFF}

# die <message>: to stderr, and to the run's summary once it has one (a container's log is
# gone with the container)
die() {
  echo "ce-fuzz: $*" >&2
  [ -n "${O:-}" ] && [ -d "$O" ] && echo "ce-fuzz: $*" >> "$O/summary.txt"
  exit 2
}

clone() {
  [ -f $BUNDLE ] || die "no bundle at $BUNDLE (mount one: -v <file>:$BUNDLE:ro)"
  # bare, so the bundle's branches are branches here, not origin/<branch>
  [ -d $SRC ] || git clone -q --bare $BUNDLE $SRC || die "cannot clone $BUNDLE"
}

# fork name: the Maven repository of its jars, chained to the shared base
repo() {
  [ -d /opt/m2/forks/$1 ] || die "no fork build '$1' (have: $(ls /opt/m2/forks | tr '\n' ' '))"
  echo "-Dmaven.repo.local=/opt/m2/forks/$1 -Dmaven.repo.local.tail=/opt/m2/base"
  echo "-Dmaven.repo.local.tail.ignoreAvailability=true"
}

# worktree <dir> <commit>
worktree() {
  git -C $SRC worktree add -q --detach "$1" "$2" || die "cannot check out $2"
}

# tries <file> <tries...> | tries <file> each <tries>: sets each @Property's tries, in the order
# the class declares them, or every one's to the same. The counts must match the file's
# properties, one each, and every property must say @Property(tries = N): a property added to a
# fuzzed class stops the run here until its job names its count, rather than inherit one sized
# for another (round p8-r0's race job ran a 200-try property 200,000 times, for days)
tries() {
  [ "${SMOKE:-0}" = 1 ] && set -- "$1" each 3
  local err
  err=$(python3 - "$@" 2>&1 <<'PY'
import re, sys
f, args = sys.argv[1], sys.argv[2:]
s = open(f).read()
props = len(re.findall(r'@Property\b', s))
found = len(re.findall(r'@Property\(tries = \d+\)', s))
if found != props:
    sys.exit('%s: %d of its %d properties say @Property(tries = N)' % (f, found, props))
counts = [args[1]] * props if len(args) == 2 and args[0] == 'each' else args
if len(counts) != props or not all(c.isdigit() for c in counts):
    sys.exit('%s has %d properties; the job gives "%s": one count per property, in order, '
             'or "each N"' % (f, props, ' '.join(args)))
it = iter(counts)
open(f, 'w').write(re.sub(r'@Property\(tries = \d+\)',
                          lambda m: '@Property(tries = %s)' % next(it), s))
PY
  ) || die "tries: $err"
}

# mutate <file> <old> <new>: replaces the one occurrence of <old>
mutate() {
  python3 - "$@" <<'PY'
import sys
f, old, new = sys.argv[1:4]
s = open(f).read()
if s.count(old) != 1:
    sys.exit('%s: %d occurrences of the anchor, not 1:\n%s' % (f, s.count(old), old))
open(f, 'w').write(s.replace(old, new))
PY
}

# job <dir> <log> <tests>: one offline test run in <dir>, waiting for a free slot of JOBS. Its
# test JVM has HEAP, and jqwik's shrinking is SHRINKING (for SHRINK_SECONDS when bounded). Its
# start and exit lines go to <log>, and everything, those lines among it, to <log>.gz: gzip
# makes a log about 40 times smaller (round p9-r0's race log, Iceberg's INFO lines mostly, is
# 12 GB as text: havoc's disk compresses it 12 times, gzip's level 6 40 times).
# Generation is random unless a property asks otherwise: jqwik (1.9) multiplies its parameters'
# exhaustive counts unchecked, so at a job's tries a large space whose product wraps negative is
# enumerated in order, only its last parameters varying (round cp4-r0's race job).
job() {
  while [ "$(jobs -rp | wc -l)" -ge "${JOBS:-64}" ]; do wait -n; done
  (
    cd "$1" || exit 2
    start=$(date +%s)
    head="start $(date -Is) $(git rev-parse --short HEAD) fork=$FORK heap=$HEAP"
    head+=" shrinking=$SHRINKING timeout=${JOB_TIMEOUT:-none}"
    head+=" snapshot_block=${SNAPSHOT_BLOCK:-default} snapshot_window=${SNAPSHOT_BLOCK:+${SNAPSHOT_WINDOW:-8}}"
    echo "$head" > "$2"
    {
      echo "$head"
      # shellcheck disable=SC2046
      MAVEN_OPTS=-Xmx512m ${JOB_TIMEOUT:+timeout -k 120 $JOB_TIMEOUT} mvn -o -B $(repo $FORK) test \
        "-DargLine=-Xmx$HEAP -Djqwik.shrinking.default=$SHRINKING -Djqwik.generation.default=RANDOMIZED
          -Djqwik.shrinking.bounded.seconds=${SHRINK_SECONDS:-1800}
          ${SNAPSHOT_BLOCK:+-Dfileio.catalog.test.snapshot.block=$SNAPSHOT_BLOCK
            -Dfileio.catalog.test.snapshot.window=${SNAPSHOT_WINDOW:-8}}" \
        -Dsurefire.failIfNoSpecifiedTests=false -Dtest="$3" 2>&1
      end="exit=$? elapsed=$(( $(date +%s) - start ))s"
      echo "$end"
      echo "$end" >> "$2"
    } | gzip > "$2.gz"
  ) &
}

# joblog <log>: the whole log of the job whose start and exit lines are in <log>: <log>.gz, or
# <log> itself if the job wrote no .gz (a driver from before 2026-11-15 wrote one plain log)
joblog() {
  if [ -f "$1.gz" ]; then gzip -dc "$1.gz" 2>/dev/null; else cat "$1"; fi
}

# the failures and errors per test class of <log>, as "f+e Class ..."
classes() {
  joblog "$1" | grep -aE "Tests run:.*in org" \
    | sed -E 's/.*Failures: ([0-9]+), Errors: ([0-9]+).* in org\.[a-z.]*\.([A-Za-z$]+)$/\1+\2 \3/' \
    | tr '\n' ' '
}

status() {
  for d in ${1:+/out/$1} ${1:-/out/*}; do
    [ -d "$d" ] || continue
    echo "### $(basename $d)"
    for f in "$d"/*.log; do
      [ -f "$f" ] || continue
      end=$(grep -ah '^exit=' "$f" | tail -1)
      echo "== $(basename $f .log): ${end:-running since $(head -1 $f | cut -d' ' -f2)}"
      # Only an ended job's log says anything (surefire and jqwik report at the end), and a
      # running one's can be gigabytes to decompress
      [ -n "$end" ] || continue
      joblog "$f" | grep -aE 'Tests run:.*in org|tries = |FAIL|original-sample|Property \[' \
        | grep -v ' tries = 3 ' | head -8
    done
    [ -f "$d/summary.txt" ] && { echo "-- summary"; cat "$d/summary.txt"; }
  done
}

# A round's jobs (ROUND_JOBS: some of them, to rerun)
ROUND_JOBS=${ROUND_JOBS:-"faultA1 faultB1 faultA2 faultB2 race mw proto azure rebase contract diff"}

# tests_of <job>: the tests a round's job (or a test job) runs; a test job's are its own
tests_of() {
  case $1 in
    faultA*|faultB*) echo TestCatalogFaultProperties ;;
    race) echo TestCatalogRaceProperties ;;
    mw) echo TestMultiWriterProperties ;;
    proto) echo TestMemoryCommitProtocol,TestAtomicFileCommitProtocol ;;
    azure) echo TestSegmentedCommitProtocol ;;
    rebase) echo TestRebaseProperties ;;
    contract) echo 'Test*Encoding' ;;
    diff) echo TestInlineDifferentialProperties,TestInlineDeltaProperties ;;
    test) ;;
    *) die "no job $1 in a round" ;;
  esac
}

# setup <job> <dir>: sets the tries of the job's properties in the worktree <dir>
setup() {
  case $1 in
    faultA*) tries $2/$T/TestCatalogFaultProperties.java 30000 1 ;;
    faultB*) tries $2/$T/TestCatalogFaultProperties.java 1 30000 ;;
    race) tries $2/$T/TestCatalogRaceProperties.java 200000 10000 ;;
    mw) tries $2/$T/spec/TestMultiWriterProperties.java each 300000 ;;
    proto)
      tries $2/intentlog-memory/src/test/java/org/intentlog/memory/TestMemoryCommitProtocol.java 300000
      tries $2/intentlog-fileio/src/test/java/org/intentlog/fileio/TestAtomicFileCommitProtocol.java 300000 ;;
    azure) tries $2/intentlog-fileio/src/test/java/org/intentlog/fileio/TestSegmentedCommitProtocol.java 1000000 ;;
    rebase)
      # shellcheck disable=SC2206
      local r=(${REBASE_TRIES:-3000}); [ ${#r[@]} = 1 ] && r=(each "${r[0]}")
      tries $2/$T/TestRebaseProperties.java "${r[@]}" ;;
    contract) tries $2/$T/ConflictEncodingContract.java each 2000 ;;
    diff)
      tries $2/$T/TestInlineDifferentialProperties.java 3500
      tries $2/$T/TestInlineDeltaProperties.java 15000 ;;
    test) ;; # tries as written
  esac
}

# paged <job>: whether a round's job pages snapshots at blocks of 2 and a window of 1 (sealing a
# table's history every commit or two, and reaching re-inlining's import pages) where the round
# sets no SNAPSHOT_BLOCK: faultA2 and faultB2, the second of each fault property's pair, so every
# round fuzzes paging (the catalog's default, blocks of 256, seals nothing in a short schedule)
paged() {
  case $1 in
    faultA2|faultB2) return 0 ;;
    *) return 1 ;;
  esac
}

round() {
  for j in $ROUND_JOBS; do
    tests_of $j > /dev/null
    worktree $W/$j $COMMIT && setup $j $W/$j
  done
  for j in $ROUND_JOBS; do
    if [ -z "${SNAPSHOT_BLOCK:-}" ] && paged $j; then
      SNAPSHOT_BLOCK=2 SNAPSHOT_WINDOW=1 job $W/$j $O/$j.log "$(tests_of $j)"
    else
      job $W/$j $O/$j.log "$(tests_of $j)"
    fi
  done
  wait
  for f in $O/*.log; do
    echo "$(basename $f .log): $(grep -ah '^exit=' $f | tail -1) | $(classes $f)" >> $O/summary.txt
  done
}

# failed <log>: the properties that failed in a job's log, one "<class> <method> <seed> <try>"
# each (<try>: the try it failed at, which with shrinking off is the first that failed, or ?):
# surefire names each failure, and jqwik's report of the property gives the seed it ran with (the
# last report's, within 20,000 characters of its header). It streams the log, which can be
# gigabytes, and reads one cut short as far as it goes.
failed() {
  python3 - "$1" <<'PY'
import gzip, os, re, sys
log = sys.argv[1]
f = (gzip.open(log + '.gz', 'rt', errors='replace') if os.path.exists(log + '.gz')
     else open(log, errors='replace'))
failure = re.compile(r'^\[ERROR\] (?:[a-z]\w*\.)*([A-Z][\w$]*)\.(\w+) -- Time elapsed.*<<< (?:FAILURE|ERROR)!')
header = re.compile(r'^timestamp = [^,]*, ([A-Z][\w$]*):(\w+) = \s*$')
seed_line = re.compile(r'^seed = (-?\d+)')
tries_line = re.compile(r'^tries = (\d+)')
failures, seeds, tries = [], {}, {}
report, budget = None, 0
try:
    for line in f:
        m = failure.match(line)
        if m and (m.group(1), m.group(2)) not in failures:
            failures.append((m.group(1), m.group(2)))
        h = header.match(line)
        if h:
            report, budget = (h.group(1), h.group(2)), 20000
            continue
        if report:
            t = tries_line.match(line)
            if t:
                tries[report] = t.group(1)
            s = seed_line.match(line)
            if s:
                seeds[report] = s.group(1)
                report = None
            else:
                budget -= len(line)
                if budget <= 0:
                    report = None
except EOFError:
    pass  # a log cut short (a container stopped while gzip wrote): what it holds
for cls, method in failures:
    if (cls, method) not in seeds:
        print('%s.%s: no seed in its report' % (cls, method), file=sys.stderr)
        continue
    print(cls, method, seeds[(cls, method)], tries.get((cls, method), '?'))
PY
}

# pin <file> <method> <seed>: runs the property <method> of <file> with <seed>
pin() {
  python3 - "$@" <<'PY'
import re, sys
f, method, seed = sys.argv[1:4]
s = open(f).read()
m = re.search(r'@Property\(tries = (\d+)\)((?:\s+@[\w.]+(?:\([^)]*\))?)*\s+)void ' + re.escape(method) + r'\(', s)
if not m:
    sys.exit('%s: no @Property(tries = N) before void %s(' % (f, method))
pinned = '@Property(tries = %s, seed = "%s")' % (m.group(1), seed)
s = s[:m.start()] + pinned + s[m.start() + len('@Property(tries = %s)' % m.group(1)):]
open(f, 'w').write(s)
PY
}

# shrink <run>/<job>: each property that failed in the job, in a worktree set up as the job's
# was, pinned to its seed, run alone (JOBS at a time, default 1), shrinking for SHRINK_SECONDS in
# a JVM of SHRINK_HEAP
shrink() {
  local log=/out/$1.log job=${1#*/}
  [ -f $log ] || die "no job log $log"
  tests_of $job > /dev/null
  HEAP=${SHRINK_HEAP:-16g}; SHRINKING=BOUNDED; JOBS=${JOBS:-1}
  JOB_TIMEOUT=${JOB_TIMEOUT:-$(( 2 * ${SHRINK_SECONDS:-1800} + 3600 ))}
  failed $log > $O/failed.txt 2>> $O/summary.txt
  [ -s $O/failed.txt ] || { echo "no failed property with a seed in $log" >> $O/summary.txt; return; }
  local cls method seed d file
  while read -r cls method seed _; do
    d=$W/$method
    worktree $d $COMMIT && setup $job $d
    file=$(find $d -path '*/src/test/java/*' -name "$cls.java" | head -1)
    [ -n "$file" ] || { echo "$cls.$method: no $cls.java" >> $O/summary.txt; continue; }
    pin $file $method $seed 2>> $O/summary.txt || continue
    job $d $O/$cls.$method.log "$cls#$method"
  done < $O/failed.txt
  wait
  while read -r cls method seed _; do
    [ -f $O/$cls.$method.log ] || continue
    echo "$cls.$method seed=$seed: $(grep -ah '^exit=' $O/$cls.$method.log | tail -1)" \
      "| shrunk: $(joblog $O/$cls.$method.log | grep -aE '^Shrunk Sample' | head -1)" >> $O/summary.txt
  done < $O/failed.txt
}

# A calibration set defines MUTANTS, ORACLES (one -Dtest), prepare <dir> (sets tries) and
# mutant <name> <main dir> <test dir> (puts the mutant back). "none" runs the oracles unmutated
# first: each must pass there, and fail on every mutant.
calib() {
  local set=/opt/ce-fuzz/mutants/$1.sh
  [ -f $set ] || die "no calibration set $1 (have: $(ls /opt/ce-fuzz/mutants | tr '\n' ' '))"
  # shellcheck source=/dev/null
  . $set
  for m in none $MUTANTS; do
    worktree $W/$m $COMMIT
    prepare $W/$m
    if [ $m != none ]; then
      (cd $W/$m && mutant $m iceberg-fileio-catalog/src/main/java/org/apache/iceberg/io \
          iceberg-fileio-catalog/src/test/java/org/apache/iceberg/io) \
        || { echo "$m: the mutant does not apply" >> $O/summary.txt; continue; }
    fi
    job $W/$m $O/$m.log "$ORACLES"
  done
  wait
  for m in none $MUTANTS; do
    [ -f $O/$m.log ] || continue
    c=$(classes $O/$m.log)
    if [ $m = none ]; then
      verdict=$(echo "$c" | grep -qE '(^| )[1-9][0-9]*\+|\+[1-9]' && echo "ORACLES FAIL UNMUTATED" || echo "clean")
    else
      verdict=$(echo "$c" | grep -qE '(^| )[1-9][0-9]*\+|\+[1-9]' && echo "caught" || echo "NOT CAUGHT")
      # the try each property first failed at: a round's tries for the property should be ten
      # times the largest of these among the mutants its job is meant to catch (calibration margin)
      if [ "$verdict" = caught ]; then
        at=$(failed $O/$m.log 2>/dev/null | awk '{printf "%s%s.%s at try %s", (NR > 1 ? ", " : ""), $1, $2, $4}')
        [ -n "$at" ] && verdict="caught ($at)"
      fi
    fi
    echo "$m: $verdict | $c" >> $O/summary.txt
  done
}

cmd=${1:-}; shift || true
case $cmd in
  round|calib|test|shrink)
    [ $# -ge 3 ] || die "usage: ce-fuzz $cmd <fork> <commit> <name> ..."
    FORK=$1; COMMIT=$2; NAME=$3; shift 3
    repo $FORK > /dev/null
    clone
    git -C $SRC rev-parse -q --verify "$COMMIT^{commit}" > /dev/null || die "no commit $COMMIT in the bundle"
    W=/work/$NAME; O=/out/$NAME
    [ -e $W ] && die "$W exists: names are one run each in a container"
    [ -n "$(ls -A $O 2>/dev/null)" ] && die "$O holds an earlier run: choose another name"
    mkdir -p $W $O
    # The worktrees, their builds and surefire's temporary files are the container's own layer
    # (round p9-r0's: 12 GB of /work and 8 GB of /tmp, about 1.7 GB on havoc's compressed disk),
    # kept with the exited container; what a run leaves is in /out, so it deletes them as it ends
    trap 'rm -rf /work /tmp/surefire-*' EXIT
    echo "$cmd fork=$FORK commit=$(git -C $SRC rev-parse --short $COMMIT) jobs=${JOBS:-all} heap=$HEAP" \
      "shrinking=$SHRINKING smoke=${SMOKE:-0} cpus=$(nproc) mem=$(free -g | awk '/Mem:/ {print $2}')G" \
      "limit=$(cat /sys/fs/cgroup/memory.max 2>/dev/null || echo unknown) $(date -Is)" > $O/run.txt
    case $cmd in
      round) round ;;
      shrink) [ $# -ge 1 ] || die "usage: ce-fuzz shrink <fork> <commit> <name> <run>/<job>"; shrink $1 ;;
      calib) [ $# -ge 1 ] || die "usage: ce-fuzz calib <fork> <commit> <name> <set>"; calib $1 ;;
      test)
        [ $# -ge 1 ] || die "usage: ce-fuzz test <fork> <commit> <name> <tests>"
        worktree $W/test $COMMIT
        job $W/test $O/test.log "$1"; wait
        echo "test: $(grep -ah '^exit=' $O/test.log | tail -1) | $(classes $O/test.log)" >> $O/summary.txt ;;
    esac
    echo "done $(date -Is)" >> $O/run.txt
    cat $O/summary.txt ;;
  status) status "${1:-}" ;;
  *) sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
