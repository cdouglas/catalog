<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.iceberg</groupId>
    <artifactId>iceberg-fileio-catalog-parent</artifactId>
    <version>1.12.0-atomicio-SNAPSHOT</version>
  </parent>

  <groupId>org.intentlog</groupId>
  <artifactId>intentlog-core</artifactId>
  <packaging>jar</packaging>

  <name>Intention log: core</name>
  <description>A replicated state machine over a shared log of intention records: the log SPI,
    replay, committed-set dedup and the commit protocol. JDK only.</description>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The core depends on the JDK alone: nothing from Iceberg, Hadoop or Guava. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>jdk-only</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.apache.iceberg</exclude>
                    <exclude>org.apache.hadoop</exclude>
                    <exclude>com.google.guava</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- exec:java target for the committed-set bench. Invoke:
           mvn -pl intentlog-core test-compile exec:java -Dexec.mainClass=org.intentlog.bench.CommittedTxnsBench -Dexec.classpathScope=test -Dexec.args="-f 0"
           -f 0 runs JMH in-process: exec:java does not give forked JVMs the test classpath.
           See docs/UUID_V7_BENCH_RESULTS.md. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
