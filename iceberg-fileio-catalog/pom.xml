<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.iceberg</groupId>
    <artifactId>iceberg-fileio-catalog-parent</artifactId>
    <version>1.12.0-atomicio-SNAPSHOT</version>
  </parent>

  <artifactId>iceberg-fileio-catalog</artifactId>
  <packaging>jar</packaging>

  <name>Iceberg FileIO Catalog</name>
  <description>A storage catalog implementation for Apache Iceberg using FileIO with atomic operations</description>

  <dependencies>
    <dependency>
      <groupId>org.intentlog</groupId>
      <artifactId>intentlog-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.intentlog</groupId>
      <artifactId>intentlog-fileio</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <!-- InMemoryAtomicFileIO, the fault-injecting store the local suites and fuzzers run on -->
      <groupId>org.intentlog</groupId>
      <artifactId>intentlog-fileio</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

    <!-- Iceberg dependencies -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-api</artifactId>
      <version>${iceberg.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-core</artifactId>
      <version>${iceberg.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-bundled-guava</artifactId>
      <version>${iceberg.version}</version>
    </dependency>

    <!-- Hadoop (for Configurable interface and LimitInputStream) -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-common</artifactId>
      <version>${hadoop.version}</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-log4j12</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.avro</groupId>
          <artifactId>avro</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Test dependencies -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- JMH for the table-metadata encoding benchmarks in org.apache.iceberg.io.bench. -->
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-generator-annprocess</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-core</artifactId>
      <version>${iceberg.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-api</artifactId>
      <version>${iceberg.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.18</version>
      <scope>test</scope>
    </dependency>

    <!-- JUnit params for parameterized tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- jqwik: property-based tests in org.apache.iceberg.io.spec -->
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <version>${jqwik.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- GCP dependencies for integration tests -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-gcp</artifactId>
      <version>${iceberg.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.cloud</groupId>
      <artifactId>google-cloud-storage</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testcontainers for local integration tests -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- AWS dependencies for integration tests -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-aws</artifactId>
      <version>${iceberg.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sts</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- iceberg-aws's default sync HTTP client; iceberg-aws declares it compileOnly -->
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>apache5-client</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- iceberg-aws's AwsClientFactories static init references KMS model classes -->
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>kms</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Azure dependencies for integration tests -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-azure</artifactId>
      <version>${iceberg.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-azure</artifactId>
      <version>${iceberg.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-storage-file-datalake</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-identity</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/aws/**</exclude>
            <exclude>**/gcp/**</exclude>
            <exclude>**/azure/**</exclude>
          </excludes>
        </configuration>
      </plugin>
      <!-- exec:java target for the JMH benchmarks in org.apache.iceberg.io.bench. Invoke:
           mvn -pl iceberg-fileio-catalog test-compile exec:java -Dexec.mainClass=org.apache.iceberg.io.bench.TableMetadataEncodingBench -Dexec.classpathScope=test
           It runs in-process: exec:java does not give forked JVMs the test classpath. See
           docs/TM_ENCODING_BENCH_RESULTS.md, and intentlog-core for the committed-set bench. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>

      <!-- Integration tests (S3, GCS, ADLS): mvn verify (Docker required for the
           emulator fallbacks; use -DskipITs to skip). With AWS_ACCESS_KEY_ID,
           AZURE_STORAGE_ACCOUNT, or GOOGLE_APPLICATION_CREDENTIALS set, the
           corresponding suite hits the real service instead of its emulator. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/aws/**</include>
            <include>**/gcp/**</include>
            <include>**/azure/**</include>
          </includes>
        </configuration>
        <executions>
          <execution>
            <id>integration-test</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Real-cloud integration tests. Activate with: mvn verify -Preal-cloud
         Requires the env vars documented in docs/INTEGRATION_TESTING.md.
         Under this profile, CloudMode#assumeRealCloud throws instead of skipping,
         and each provider's @BeforeAll fails fast if its real-cloud env vars are
         missing. -->
    <profile>
      <id>real-cloud</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <systemPropertyVariables combine.children="append">
                <require.real.cloud>true</require.real.cloud>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
