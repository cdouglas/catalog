<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.iceberg</groupId>
    <artifactId>iceberg-fileio-catalog-parent</artifactId>
    <version>1.12.0-atomicio-SNAPSHOT</version>
  </parent>

  <groupId>org.intentlog</groupId>
  <artifactId>intentlog-azure</artifactId>
  <packaging>jar</packaging>

  <name>Intention log: Azure Append Blobs</name>
  <description>A shared log on Azure Append Blobs (docs/AZURE_LOG.md): records appended without a
    position condition to segments that a pad closes at their size limit, a head changed only by
    CAS, and checkpoints stored apart. Over a narrow store interface, with an in-memory store whose
    hooks inject faults and one on the Azure SDK.</description>

  <dependencies>
    <dependency>
      <groupId>org.intentlog</groupId>
      <artifactId>intentlog-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-storage-blob</artifactId>
    </dependency>
    <dependency>
      <groupId>org.intentlog</groupId>
      <artifactId>intentlog-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Like the core: nothing from Iceberg, Hadoop or Guava. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>jdk-only</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.apache.iceberg</exclude>
                    <exclude>org.apache.hadoop</exclude>
                    <exclude>com.google.guava</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
