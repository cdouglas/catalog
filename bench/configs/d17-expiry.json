{
  "label": "d17-expiry",
  "store": "s3x",
  "runtime_sigma": 0.5,
  "runtime_ms": {
    "compaction": 5000
  },
  "vary": {
    "+workload": [
      {
        "mix": {
          "fast_append": 1.0
        }
      },
      {
        "mix": {
          "fast_append": 0.95,
          "compaction": 0.05
        },
        "expire_older_than_s": 30
      }
    ],
    "expiry_merge": [
      true,
      false
    ],
    "encoding": [
      "lamport",
      "concern-vector",
      "blind-append",
      "partition-vector",
      "manifest-window"
    ],
    "writers": [
      16,
      32
    ],
    "repetition": [
      0,
      1
    ]
  }
}
