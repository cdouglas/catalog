{
  "label": "i1-ingest",
  "retention_s": 21600,
  "capture": {
    "label": "cap-i1",
    "encoding": "manifest-window",
    "writers": 16,
    "tables": 16,
    "mix": {"merge_append": 0.85, "fast_append": 0.05, "validated_overwrite": 0.05, "compaction": 0.05},
    "race_min_wait_ms": 0,
    "duration_s": 600, "warmup_s": 5, "drain_s": 10,
    "expire_every_s": 5, "expire_retain": 100, "expire_retry_num": 100
  },
  "max_ingest_s": 120,
  "compact_every": 0,
  "vary": {
    "+load": [
      {"rate": 100, "prefill": false}, {"rate": 100, "prefill": true},
      {"rate": 1000, "prefill": false}, {"rate": 1000, "prefill": true},
      {"rate": 10000, "prefill": false}
    ],
    "batch": [1, 64, 1024]
  }
}
